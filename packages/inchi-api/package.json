{
  "name": "inchi-api",
  "version": "1.0.0",
  "private": true,
  "description": "HTTP API converting structures to InChI and enriching CSV/TSV/XLSX/SDF files with InChI and InChIKey.",
  "type": "module",
  "exports": {
    "./convert": "./src/convert/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "npm run test-only && npm run check-types",
    "test-only": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.0",
    "inchi-js": "*",
    "openchemlib": "^9.25.0",
    "papaparse": "^5.6.0",
    "sdf-creator": "^4.0.0",
    "sdf-parser": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@zakodium/tsconfig": "^1.0.5",
    "vitest": "^4.1.10"
  }
}
