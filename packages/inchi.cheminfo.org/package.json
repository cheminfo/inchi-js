{
  "name": "inchi.cheminfo.org",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive web playground for the inchi-js library — round-trip molecule ↔ InChI ↔ InChIKey.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "eslint": "eslint src",
    "eslint-fix": "eslint src --fix",
    "preview": "vite preview",
    "prettier": "prettier --check src",
    "prettier-write": "prettier --write src",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-e2e": "playwright test",
    "test-e2e-ui": "playwright test --ui",
    "test-only": "vitest run --coverage"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.15.0",
    "@blueprintjs/icons": "^6.10.0",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tanstack/react-virtual": "^3.13.26",
    "@uiw/react-codemirror": "^4.25.10",
    "inchi-js": "*",
    "openchemlib": "^9.22.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ocl": "^8.7.1",
    "react-science": "^19.11.0",
    "sdf-creator": "^4.0.0",
    "sdf-parser": "^9.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "@zakodium/tsconfig": "^1.0.5",
    "eslint": "^9.39.4",
    "eslint-config-cheminfo-react": "^20.0.1",
    "eslint-config-cheminfo-typescript": "^22.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
