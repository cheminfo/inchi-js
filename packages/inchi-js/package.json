{
  "name": "inchi-js",
  "version": "0.1.0",
  "license": "MIT",
  "description": "InChI engine in TypeScript: convert Molfile ↔ InChI ↔ InChIKey. Wraps the official IUPAC InChI C library compiled to WebAssembly and base64-embedded so the package is self-contained.",
  "keywords": [
    "inchi",
    "inchikey",
    "molfile",
    "cheminformatics",
    "iupac",
    "wasm",
    "webassembly"
  ],
  "author": "Luc Patiny",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/inchi-js.d.ts",
      "default": "./lib/inchi-js.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "benchmark": "node benchmark/bench-inchi.ts",
    "build-wasm": "bash build/build-wasm.sh",
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib",
    "eslint": "eslint benchmark src",
    "eslint-fix": "eslint benchmark src --fix",
    "prepack": "npm run tsc",
    "prepublishOnly": "npm test",
    "prettier": "prettier --check benchmark src",
    "prettier-write": "prettier --write benchmark src",
    "test": "npm run test-only && npm run test-bundle && npm run check-types && npm run eslint && npm run prettier",
    "test-bundle": "npm run tsc && vitest run --config vitest.config.bundle.ts",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && node build/bundle.js"
  },
  "dependencies": {
    "uint8-base64": "^1.0.0"
  },
  "peerDependencies": {
    "openchemlib": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@zakodium/tsconfig": "^1.0.5",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-cheminfo-typescript": "^22.0.0",
    "openchemlib": "^9.22.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
